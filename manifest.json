{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.40",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://*.kick.com/*",
    "*://gql.twitch.tv/*",
    "*://kick.com/*",
    "*://*.twitchsvc.net/*",
    "*://*.ttvnw.net/*",
    "*://*.live-video.net/*",
    "*://*.7tv.io/*",
    "*://cdn.7tv.app/*",
    "*://*.pusher.com/*",
    "*://static-cdn.jtvnw.net/*"
  ],
  "icons": {
    "16": "icons/ghost16.png",
    "32": "icons/ghost32.png",
    "48": "icons/ghost48.png",
    "128": "icons/ghost128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/ghost16.png",
      "32": "icons/ghost32.png",
      "48": "icons/ghost48.png",
      "128": "icons/ghost128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_tracking",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "hls.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ghostviewer@extension",
      "strict_min_version": "121.0"
    }
  }
}